---
// Panel Decap CMS — dirender sebagai halaman Astro agar URL /admin berfungsi
// baik di dev server maupun produksi. Konfigurasi: public/admin/config.yml.
// Mode lokal (dummy): jalankan `npm run cms` lalu buka /admin — tanpa login.
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Kelola Konten · Al Akhyar</title>
    <link rel="cms-config-url" type="text/yaml" href="/admin/config.yml" />
  </head>
  <body>
    <!-- Netlify Identity widget: login Google (Al Akhyar) untuk produksi -->
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <!-- Decap CMS — pin versi stabil (3.11.0 terbaru crash React #130 saat load
         dashboard dengan git-gateway; jangan pakai range ^3.0.0) -->
    <script is:inline src="https://unpkg.com/decap-cms@3.3.3/dist/decap-cms.js"></script>
    <script is:inline>
      // MODE AMAN: buka /admin?safe=1 untuk melewati seluruh penyesuaian kustom
      // di bawah (login Google-saja, kunci Publish, auto-isi Penulis). Berguna
      // sebagai jalan keluar bila salah satu skrip mengganggu tampilan CMS.
      window.AK_SAFE = new URLSearchParams(location.search).has('safe');
      if (window.AK_SAFE) console.warn('[Al Akhyar] Mode aman aktif — penyesuaian kustom dilewati.');
    </script>
    <script is:inline>
      if (!window.AK_SAFE) {
      // Sederhanakan layar login: hanya "Continue with Google".
      // Widget Netlify Identity dirender di dalam iframe same-origin, jadi CSS
      // bisa disuntikkan dari sini untuk menyembunyikan tab Sign up, form
      // email/password, dan pemisah "OR".
      (function () {
        var CSS = [
          /* tab "Sign up" / "Log in" di atas modal */
          '[class*="header"] a, [class*="btnHeader"] { display: none !important; }',
          /* form email + password + tombol Log in + Forgot password */
          'form { display: none !important; }',
          /* pemisah "OR" (widget menulisnya "seperator") */
          '[class*="eperator"], [class*="eparator"], hr { display: none !important; }',
          /* rapikan jarak agar tombol Google tidak menggantung */
          '[class*="providersGroup"] { margin: 0 !important; }',
        ].join('\n');

        function suntik(doc) {
          if (!doc || doc.getElementById('ak-login-css')) return;
          var st = doc.createElement('style');
          st.id = 'ak-login-css';
          st.textContent = CSS;
          (doc.head || doc.documentElement).appendChild(st);
        }

        // Widget membuat iframe-nya belakangan, jadi pantau sampai muncul.
        var n = 0;
        var timer = setInterval(function () {
          var f = document.getElementById('netlify-identity-widget');
          if (f && f.contentDocument) suntik(f.contentDocument);
          if (++n > 100) clearInterval(timer); // berhenti setelah ~20 detik
        }, 200);
      })();

      // ====== Kunci tombol Publish ======
      // Default: semua guru hanya bisa menyimpan Draft. Hanya user dengan role
      // "editor" atau "admin" (di-set lewat Netlify > Identity > Users >
      // Edit settings > roles) yang melihat tombol Publish.
      // Catatan: ini penegakan sisi-browser untuk memandu alur kerja tim,
      // bukan kunci kriptografis.
      (function () {
        var ROLE_TERBIT = ['editor', 'admin'];
        var pengamat = null;
        var terjadwal = false;

        function bolehTerbit(user) {
          var roles = (user && user.app_metadata && user.app_metadata.roles) || [];
          for (var i = 0; i < ROLE_TERBIT.length; i++) {
            if (roles.indexOf(ROLE_TERBIT[i]) > -1) return true;
          }
          return false;
        }

        function sapu() {
          terjadwal = false;
          var els = document.querySelectorAll('button, [role="button"]');
          for (var i = 0; i < els.length; i++) {
            var el = els[i];
            if (el.__akDicek) continue;
            el.__akDicek = 1;
            // Jangan sentuh elemen pembungkus: kalau di dalamnya masih ada
            // tombol lain, menyembunyikannya bisa mengosongkan seluruh editor.
            if (el.querySelector('button, [role="button"], input, textarea')) continue;
            // cocokkan hanya tombol yang teksnya diawali "Publish"
            // (Publish, Publish now, Publish and Create New, ...)
            var t = (el.textContent || '').trim();
            if (/^publish\b/i.test(t) && t.length <= 40) {
              el.style.display = 'none';
            }
          }
        }

        function jadwalkanSapu() {
          if (terjadwal) return;
          terjadwal = true;
          requestAnimationFrame(sapu);
        }

        function kunci() {
          if (pengamat) return;
          sapu();
          pengamat = new MutationObserver(jadwalkanSapu);
          pengamat.observe(document.body, { childList: true, subtree: true });
          tampilkanCatatan();
        }

        function tampilkanCatatan() {
          if (document.getElementById('ak-catatan-draft')) return;
          var bar = document.createElement('div');
          bar.id = 'ak-catatan-draft';
          bar.textContent =
            'Mode kontributor — tulisan Anda tersimpan sebagai draft. Penerbitan dilakukan oleh editor.';
          bar.setAttribute(
            'style',
            'position:fixed;left:0;right:0;bottom:0;z-index:9999;' +
              'background:#006195;color:#fff;font:600 13px/1.4 system-ui,sans-serif;' +
              'padding:10px 16px;text-align:center;'
          );
          document.body.appendChild(bar);
        }

        function periksa(user) {
          if (!bolehTerbit(user)) kunci();
        }

        if (window.netlifyIdentity) {
          window.netlifyIdentity.on('init', periksa);
          window.netlifyIdentity.on('login', periksa);
        }
      })();

      // ====== Field "Penulis" terisi otomatis ======
      // Nama diambil dari akun Google yang sedang login. Diisi saat form dibuka
      // (agar penulis melihatnya) dan dijamin ulang saat simpan.
      (function () {
        function namaPenulis() {
          var u = window.netlifyIdentity && window.netlifyIdentity.currentUser();
          return (
            (u && u.user_metadata && u.user_metadata.full_name) || (u && u.email) || ''
          );
        }

        // Mengisi input React perlu native setter + event, bukan sekadar .value
        function isiInput(el, nilai) {
          var proto = window.HTMLInputElement.prototype;
          var setter = Object.getOwnPropertyDescriptor(proto, 'value').set;
          setter.call(el, nilai);
          el.dispatchEvent(new Event('input', { bubbles: true }));
          el.dispatchEvent(new Event('change', { bubbles: true }));
        }

        function isiFieldPenulis() {
          var nama = namaPenulis();
          if (!nama) return;
          var labels = document.querySelectorAll('label');
          for (var i = 0; i < labels.length; i++) {
            if ((labels[i].textContent || '').trim().toLowerCase() !== 'penulis') continue;
            var id = labels[i].getAttribute('for');
            var input = id
              ? document.getElementById(id)
              : labels[i].parentElement && labels[i].parentElement.querySelector('input');
            // hanya isi bila masih kosong — jangan timpa tulisan orang lain
            if (input && !input.value && !input.__akTerisi) {
              input.__akTerisi = 1;
              isiInput(input, nama);
            }
          }
        }

        var jadwal = false;
        function jadwalkan() {
          if (jadwal) return;
          jadwal = true;
          requestAnimationFrame(function () {
            jadwal = false;
            isiFieldPenulis();
          });
        }

        function mulai() {
          isiFieldPenulis();
          new MutationObserver(jadwalkan).observe(document.body, {
            childList: true,
            subtree: true,
          });
        }

        if (window.netlifyIdentity) {
          window.netlifyIdentity.on('init', mulai);
          window.netlifyIdentity.on('login', mulai);
        }
      })();

      // Jaring pengaman: pastikan Penulis terisi saat entri disimpan.
      CMS.registerEventListener({
        name: 'preSave',
        handler: function ({ entry }) {
          try {
            var user = window.netlifyIdentity && window.netlifyIdentity.currentUser();
            var nama =
              (user && user.user_metadata && user.user_metadata.full_name) ||
              (user && user.email) ||
              '';
            var data = entry.get('data');
            if (nama && !data.get('author')) {
              return data.set('author', nama);
            }
            return data;
          } catch (e) {
            return entry.get('data');
          }
        },
      });
      } // akhir blok "if (!window.AK_SAFE)"
    </script>
  </body>
</html>
