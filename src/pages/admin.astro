<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Kelola Konten · Al Akhyar</title>
    <link rel="cms-config-url" href="/admin/config.yml" />
  </head>
  <body>
    <!-- Netlify Identity widget: login Google (Al Akhyar) untuk produksi -->
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <!-- Decap CMS -->
    <script is:inline src="https://unpkg.com/decap-cms@^3.0.0/dist/decap-cms.js"></script>
  </body>
</html>
