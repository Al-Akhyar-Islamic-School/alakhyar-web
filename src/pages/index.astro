---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BeritaCard from '../components/BeritaCard.astro';
import AlumniSMA from '../components/AlumniSMA.astro';
import { site, jenjang, pilar, stats, kurikulum, dinar, testimoni } from '../data/site';
import heroFoto from '../assets/foto/gedung-utama.jpg';
import dinarSS from '../assets/brand/Dinar APP SS.png';
import dinarLogo from '../assets/brand/Dinar App logo.png';
import goalCurriculum from '../assets/brand/goal-curriculum.png';
import fotoTK from '../assets/foto/jenjang-tk.jpg';
import fotoSD from '../assets/foto/jenjang-sd.jpg';
import fotoSMP from '../assets/foto/jenjang-smp.jpg';
import fotoSMA from '../assets/foto/jenjang-sma.jpg';
import type { ImageMetadata } from 'astro';

const fotoJenjang: Record<string, ImageMetadata> = {
  tk: fotoTK,
  sd: fotoSD,
  smp: fotoSMP,
  sma: fotoSMA,
};

const semua = (await getCollection('berita', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const [utama, ...sisa] = semua.filter((p) => p.data.cover);
const terbaru = sisa.slice(0, 4);

// Galeri marquee: foto sampul 12 artikel terbaru — dokumentasi asli sekolah
const galeri = semua
  .filter((p) => p.data.cover)
  .slice(0, 12)
  .map((p) => ({ src: p.data.cover!, judul: p.data.title }));

const warnaHeader: Record<string, string> = {
  primary: 'from-primary-500 to-primary-600',
  sky: 'from-sky-500 to-sky-600',
  magenta: 'from-magenta-500 to-magenta-600',
  coral: 'from-coral-500 to-coral-600',
};
const warnaPilar: Record<string, string> = {
  primary: 'border-t-primary-500 text-primary-600',
  sky: 'border-t-sky-500 text-sky-600',
  green: 'border-t-green-500 text-green-600',
};

const fmtTanggal = (d: Date) =>
  d.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout>
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden bg-white">
    <!-- ornamen latar -->
    <div class="absolute inset-0 pattern-dots-dark opacity-40" aria-hidden="true"></div>
    <div
      class="absolute -top-32 -right-32 w-[480px] h-[480px] rounded-full bg-sky-100 blur-3xl opacity-60"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute -bottom-40 -left-24 w-[380px] h-[380px] rounded-full bg-primary-50 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="container-ak relative grid lg:grid-cols-[1.05fr_1fr] gap-12 items-center py-16 lg:py-24">
      <div data-reveal>
        <span
          class="inline-flex items-center gap-2 rounded-full border border-primary-100 bg-primary-50 px-4 py-1.5 text-xs font-bold text-primary-600 mb-6"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
          SPMB 2026/2027 telah dibuka
        </span>
        <h1 class="font-display font-bold text-ink text-4xl md:text-[54px] leading-[1.08] tracking-tight mb-6">
          Mendidik Generasi<br />
          <span class="text-gradient-brand">Unggul & Berakhlak</span>
        </h1>
        <p class="text-lg text-slate-500 leading-relaxed max-w-xl mb-8">
          Lebih dari 20 tahun Sekolah Islam Al Akhyar Makassar membina putra-putri
          bangsa — memadukan Kurikulum Merdeka berciri khas keislaman, tahfidz
          Qur’an &amp; hadits, dalam empat jenjang: TK/KB, SD, SMP, dan SMA Islam.
        </p>
        <div class="flex flex-wrap gap-3 mb-10">
          <a href="/spmb" class="btn btn-primary text-base !px-7 !py-3.5">Daftar Sekarang</a>
          <a href="/jenjang" class="btn btn-ghost text-base !px-7 !py-3.5">Lihat Jenjang</a>
        </div>
        <div class="grid sm:grid-cols-2 gap-x-6 gap-y-3.5 text-sm text-slate-500 max-w-lg">
          <div class="flex items-center gap-2.5">
            <span class="shrink-0 w-8 h-8 rounded-full bg-green-100 text-green-600 flex items-center justify-center font-extrabold text-sm">
              A
            </span>
            Terakreditasi A BAN S/M
          </div>
          <div class="flex items-center gap-2.5">
            <span class="shrink-0 w-8 h-8 rounded-full bg-amber-100 text-amber-500 flex items-center justify-center">☪</span>
            Tahfidz Qur’an &amp; Hadits
          </div>
          <div class="flex items-center gap-2.5">
            <span class="shrink-0 w-8 h-8 rounded-full bg-sky-100 text-sky-600 flex items-center justify-center">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
              </svg>
            </span>
            Full Day School
          </div>
          <div class="flex items-center gap-2.5">
            <span class="shrink-0 w-8 h-8 rounded-full bg-primary-50 text-primary-600 flex items-center justify-center">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 7c-1.8-1.3-4-2-6.5-2H4v13h1.5c2.5 0 4.7.7 6.5 2 1.8-1.3 4-2 6.5-2H20V5h-1.5c-2.5 0-4.7.7-6.5 2Z" />
                <path d="M12 7v13" />
              </svg>
            </span>
            Kurikulum Islami Unggul &amp; Berakhlak
          </div>
        </div>
      </div>

      <div class="relative" data-reveal style="--reveal-delay: 120ms">
        <div class="relative aspect-[4/3] rounded-[28px] overflow-hidden shadow-lg rotate-1">
          <Image
            src={heroFoto}
            alt="Kampus Sekolah Islam Al Akhyar Makassar"
            class="w-full h-full object-cover"
            loading="eager"
            widths={[640, 960, 1280]}
            sizes="(max-width: 1024px) 92vw, 520px"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-primary-900/45 via-transparent to-transparent"></div>
          <p class="absolute bottom-4 right-5 max-w-[60%] text-right text-white text-sm font-medium drop-shadow">
            Kampus Al Akhyar · Sudiang, {site.city}
          </p>
        </div>
        <!-- kartu mengambang -->
        <div
          class="absolute -bottom-7 -left-2 sm:left-8 bg-white/90 backdrop-blur rounded-2xl shadow-md border border-slate-200 px-5 py-4 -rotate-1"
        >
          <p class="text-xs text-slate-400 mb-1">Tiga Pilar Kurikulum</p>
          <p class="font-bold text-ink">Iman · Ilmu · Ihsan</p>
        </div>
        <div
          class="absolute -top-5 -right-2 sm:right-4 bg-brand-gradient text-white rounded-2xl shadow-brand px-5 py-3.5 rotate-2"
        >
          <p class="text-[11px] text-white/70 uppercase tracking-wide font-bold">Sejak</p>
          <p class="font-display font-bold text-2xl leading-none">2004</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ STATS BAND ============ -->
  <section class="bg-brand-gradient relative overflow-hidden">
    <div class="absolute inset-0 pattern-dots" aria-hidden="true"></div>
    <div class="container-ak relative grid grid-cols-2 lg:grid-cols-4 gap-y-8 py-12">
      {
        stats.map((s, i) => (
          <div class="text-center text-white" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <p class="font-display font-bold text-4xl md:text-5xl mb-1">{s.angka}</p>
            <p class="font-semibold text-white/95 text-sm">{s.label}</p>
            <p class="text-xs text-white/60 mt-0.5">{s.ket}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ============ KURIKULUM — nilai jual utama ============ -->
  <section class="container-ak py-20">
    <div class="max-w-2xl mx-auto text-center mb-12" data-reveal>
      <span class="eyebrow">Kurikulum Al Akhyar</span>
      <h2 class="text-3xl md:text-4xl font-bold text-ink mt-3 mb-4">
        Dua Kurikulum, Satu Tujuan:<br class="hidden md:block" /> Unggul &amp; Berakhlak
      </h2>
      <p class="text-slate-500">
        Tidak sekadar kurikulum nasional — setiap siswa Al Akhyar menempuh{' '}
        <strong>dua kurikulum sekaligus</strong> yang saling menguatkan.
      </p>

    </div>

    <!-- dua kurikulum -->
    <div class="grid md:grid-cols-2 gap-6 mb-8">
      <div class="rounded-[24px] bg-white border border-slate-200 shadow-sm p-8" data-reveal>
        <span class="chip bg-sky-100 text-sky-600 mb-4">{kurikulum.nasional.ket}</span>
        <h3 class="font-display font-bold text-2xl text-ink mb-3">{kurikulum.nasional.nama}</h3>
        <p class="text-slate-500 leading-relaxed">{kurikulum.nasional.deskripsi}</p>
      </div>
      <div class="rounded-[24px] bg-brand-gradient text-white shadow-brand p-8 relative overflow-hidden" data-reveal style="--reveal-delay: 100ms">
        <div class="absolute inset-0 pattern-dots" aria-hidden="true"></div>
        <div class="relative">
          <span class="chip bg-white/20 text-white mb-4">{kurikulum.islami.ket}</span>
          <h3 class="font-display font-bold text-2xl mb-3">{kurikulum.islami.nama}</h3>
          <p class="text-white/85 leading-relaxed">{kurikulum.islami.deskripsi}</p>
        </div>
      </div>
    </div>

    <!-- Goal Curriculum — tampil di mobile; di desktop tersedia lengkap di /kurikulum -->
    <Image
      src={goalCurriculum}
      alt="Goal Curriculum Unggul & Berakhlak: Iman, Ilmu, Ihsan"
      class="md:hidden w-full max-w-xs mx-auto h-auto mb-10"
      widths={[320, 640]}
      sizes="320px"
      loading="lazy"
      data-reveal
    />

    <!-- pilar + pembiasaan harian -->
    <div class="grid lg:grid-cols-[1fr_1fr] gap-6 items-stretch">
      <div class="grid grid-cols-3 gap-4">
        {
          pilar.map((p, i) => (
            <div
              class={`card-ak border-t-4 ${warnaPilar[p.warna]} p-5 text-center`}
              data-reveal
              style={`--reveal-delay: ${i * 80}ms`}
            >
              <h3 class="font-bold text-ink text-lg mb-1">{p.nama}</h3>
              <p class="text-xs text-slate-500 leading-snug">{p.deskripsi}</p>
            </div>
          ))
        }
      </div>
      <div class="rounded-2xl bg-slate-100 border border-slate-200 p-6" data-reveal style="--reveal-delay: 150ms">
        <h3 class="font-semibold text-ink mb-3">Pembiasaan Setiap Hari</h3>
        <ul class="grid sm:grid-cols-2 gap-2.5">
          {
            kurikulum.harian.map((h) => (
              <li class="flex gap-2 items-start text-sm text-slate-600">
                <span class="text-green-500 font-bold mt-0.5">✓</span>
                {h}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="text-center mt-10" data-reveal>
      <a href={site.kurikulumUrl} target="_blank" rel="noopener" class="btn btn-primary">
        Jelajahi Dokumen Kurikulum Lengkap
      </a>
      <p class="text-xs text-slate-400 mt-3">
        Transparan &amp; terdokumentasi terbuka di kurikulum.alakhyar.sch.id — dari profil
        lulusan, struktur per jenjang, hingga sistem asesmen.
      </p>
    </div>
  </section>

  <!-- ============ JENJANG ============ -->
  <section class="bg-slate-100/70 border-y border-slate-200">
    <div class="container-ak py-20">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-12" data-reveal>
        <div class="max-w-xl">
          <span class="eyebrow">Jenjang Pendidikan</span>
          <h2 class="text-3xl md:text-4xl font-bold text-ink mt-3">
            Perjalanan Belajar yang Berkesinambungan
          </h2>
        </div>
        <a href="/jenjang" class="text-sm font-semibold text-primary-600 hover:text-primary-700 shrink-0">
          Semua jenjang →
        </a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {
          jenjang.map((j, i) => (
            <a
              href={`/jenjang/${j.slug}`}
              class="group rounded-2xl bg-white border border-slate-200 shadow-sm overflow-hidden transition-all duration-200 hover:-translate-y-1 hover:shadow-md"
              data-reveal
              style={`--reveal-delay: ${i * 90}ms`}
            >
              <div class={`bg-gradient-to-br ${warnaHeader[j.warna]} px-6 pt-6 pb-8 rounded-b-[24px] text-white relative overflow-hidden`}>
                <div class="absolute inset-0 pattern-dots opacity-60" aria-hidden="true" />
                <p class="relative text-[11px] uppercase tracking-wider font-bold text-white/70">{j.umur}</p>
                <h3 class="relative font-display font-bold text-2xl mt-1">{j.nama}</h3>
              </div>
              <div class="px-4 pt-4">
                <Image
                  src={fotoJenjang[j.slug]}
                  alt={`Suasana belajar ${j.lengkap}`}
                  class="w-full aspect-[16/10] object-cover rounded-xl"
                  widths={[320, 640]}
                  sizes="(max-width: 640px) 90vw, 280px"
                  loading="lazy"
                />
              </div>
              <div class="p-6">
                <p class="text-sm text-slate-500 leading-relaxed">{j.deskripsi}</p>
                <span class="inline-block text-sm font-semibold text-primary-600 mt-4 group-hover:translate-x-1 transition-transform">
                  Selengkapnya →
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ DINAR APP — nilai jual digital ============ -->
  <section class="relative overflow-hidden bg-primary-900 text-white">
    <div class="absolute inset-0 pattern-dots opacity-50" aria-hidden="true"></div>
    <div
      class="absolute -top-24 -left-24 w-[420px] h-[420px] rounded-full bg-sky-500/20 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div class="container-ak relative py-20">
      <div class="max-w-2xl mb-4" data-reveal>
        <span class="inline-flex items-center gap-2.5 mb-5">
          <Image src={dinarLogo} alt="Logo Dinar App" width={44} height={44} class="h-10 w-auto rounded-xl bg-white/95 p-1" />
          <span class="text-xs font-bold uppercase tracking-[0.08em] text-sky-300">{dinar.judul}</span>
        </span>
        <h2 class="font-display text-3xl md:text-4xl font-bold mb-4">
          Dinar App — Sekolah dalam Genggaman Orang Tua
        </h2>
        <p class="text-white/70 text-lg max-w-xl">{dinar.deskripsi}</p>
      </div>

      <div class="my-6" data-reveal>
        <Image
          src={dinarSS}
          alt="Tampilan aplikasi Dinar: roster kelas, jadwal shalat, hafalan Qur'an, agenda sekolah, kartu digital, dan e-rapor"
          class="w-full h-auto"
          widths={[768, 1280, 1920]}
          sizes="100vw"
        />
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {
          dinar.fitur.map((f, i) => (
            <div
              class="rounded-2xl bg-white/[0.06] border border-white/10 backdrop-blur px-5 py-4"
              data-reveal
              style={`--reveal-delay: ${i * 60}ms`}
            >
              <h3 class="font-semibold text-white text-sm mb-1">{f.nama}</h3>
              <p class="text-xs text-white/55 leading-snug">{f.ket}</p>
            </div>
          ))
        }
      </div>

      <div class="text-center mt-10" data-reveal>
        <a href={site.dinarUrl} target="_blank" rel="noopener" class="btn bg-white text-primary-700 hover:bg-slate-100">
          Buka dinar.alakhyar.sch.id
        </a>
      </div>
    </div>
  </section>

  <!-- ============ GALERI MARQUEE ============ -->
  <section class="py-16 overflow-hidden" aria-label="Galeri kegiatan">
    <div class="container-ak mb-8" data-reveal>
      <span class="eyebrow">Galeri</span>
      <h2 class="text-3xl font-bold text-ink mt-2">Momen Nyata di Al Akhyar</h2>
    </div>
    <div class="relative">
      <div class="marquee-track flex gap-5 w-max">
        {
          [...galeri, ...galeri].map((g) => (
            <figure class="w-64 shrink-0">
              <img
                src={g.src}
                alt={g.judul}
                width="256"
                height="176"
                loading="lazy"
                decoding="async"
                class="w-64 h-44 object-cover rounded-2xl border border-slate-200 shadow-sm"
              />
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ BERITA ============ -->
  {
    utama && (
      <section class="container-ak py-16">
        <div class="flex items-end justify-between mb-10" data-reveal>
          <div>
            <span class="eyebrow">Berita &amp; Kabar</span>
            <h2 class="text-3xl md:text-4xl font-bold text-ink mt-3">Kabar Terbaru</h2>
          </div>
          <a href="/berita" class="hidden sm:inline text-sm font-semibold text-primary-600 hover:text-primary-700">
            Semua berita →
          </a>
        </div>
        <div class="grid lg:grid-cols-2 gap-8">
          <!-- artikel unggulan -->
          <a href={`/berita/${utama.id}`} class="group relative rounded-[24px] overflow-hidden shadow-md min-h-[380px] flex" data-reveal>
            <img
              src={utama.data.cover}
              alt={utama.data.title}
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary-900/85 via-primary-900/30 to-transparent" />
            <div class="relative self-end p-7 text-white">
              <span class="chip bg-white/20 backdrop-blur text-white mb-3">{utama.data.category}</span>
              <h3 class="font-bold text-2xl leading-snug mb-2 group-hover:underline decoration-2 underline-offset-4">
                {utama.data.title}
              </h3>
              <p class="text-sm text-white/70">{fmtTanggal(utama.data.pubDate)}</p>
            </div>
          </a>
          <!-- daftar ringkas -->
          <div class="flex flex-col gap-4">
            {terbaru.map((p, i) => (
              <a
                href={`/berita/${p.id}`}
                class="group flex gap-4 items-center card-ak !rounded-2xl p-3.5"
                data-reveal
                style={`--reveal-delay: ${i * 80}ms`}
              >
                <img
                  src={p.data.cover}
                  alt=""
                  width="112"
                  height="84"
                  loading="lazy"
                  decoding="async"
                  class="w-28 h-21 object-cover rounded-xl shrink-0"
                />
                <div class="min-w-0">
                  <p class="text-[11px] font-bold uppercase tracking-wide text-primary-600 mb-1">
                    {p.data.category} · {fmtTanggal(p.data.pubDate)}
                  </p>
                  <h3 class="font-semibold text-ink leading-snug line-clamp-2 group-hover:text-primary-600 transition-colors">
                    {p.data.title}
                  </h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ============ TESTIMONI & ALUMNI ============ -->
  <section class="container-ak py-16">
    <div class="max-w-2xl mx-auto text-center mb-10" data-reveal>
      <span class="eyebrow">Kata Mereka</span>
      <h2 class="text-3xl md:text-4xl font-bold text-ink mt-3">
        Dipercaya Orang Tua, Dikenang Alumni
      </h2>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        testimoni.map((t, i) => (
          <figure class="card-ak p-7 flex flex-col" data-reveal style={`--reveal-delay: ${(i % 3) * 90}ms`}>
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" class="text-primary-200 mb-4" aria-hidden="true">
              <path d="M9.6 4C5.9 6 3.5 9.4 3.5 13.6c0 3.4 2 6.4 5.3 6.4 2.5 0 4.4-1.9 4.4-4.3 0-2.3-1.7-4-3.9-4-.4 0-.9.1-1 .1.3-2.3 2-4.6 4-5.9L9.6 4Zm10.4 0c-3.7 2-6.1 5.4-6.1 9.6 0 3.4 2 6.4 5.3 6.4 2.5 0 4.4-1.9 4.4-4.3 0-2.3-1.7-4-3.9-4-.4 0-.8.1-1 .1.3-2.3 2-4.6 4-5.9L20 4Z" />
            </svg>
            <blockquote class="text-slate-600 text-sm leading-relaxed flex-1">“{t.teks}”</blockquote>
            <figcaption class="mt-5 pt-4 border-t border-slate-100 flex items-center gap-3">
              <span class="w-9 h-9 rounded-full bg-primary-100 text-primary-600 font-bold text-sm flex items-center justify-center shrink-0">
                {t.nama.charAt(0)}
              </span>
              <span>
                <p class="font-bold text-ink text-sm">{t.nama}</p>
                <p class="text-xs text-slate-400">{t.peran}</p>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <!-- Alumni SMA -->
    <div class="mt-12">
      <AlumniSMA />
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="container-ak pb-20 pt-4">
    <div class="relative rounded-[28px] bg-brand-gradient text-white overflow-hidden shadow-brand" data-reveal>
      <div class="absolute inset-0 pattern-dots" aria-hidden="true"></div>
      <div
        class="absolute -right-16 -top-16 w-64 h-64 rounded-full bg-white/10 blur-2xl"
        aria-hidden="true"
      >
      </div>
      <div class="relative px-8 py-14 md:px-16 md:py-16 grid md:grid-cols-[1.4fr_1fr] gap-8 items-center">
        <div>
          <h2 class="font-display text-3xl md:text-4xl font-bold mb-4 leading-tight">
            Amanahkan Pendidikan Putra-Putri Anda kepada Kami
          </h2>
          <p class="text-white/80 max-w-xl">
            Kuota SPMB Tahun Ajaran 2026/2027 terbatas untuk setiap jenjang.
            Tersedia jalur beasiswa tahfidz melalui sistem Poinku.
          </p>
        </div>
        <div class="flex md:justify-end gap-3 flex-wrap">
          <a href="/spmb" class="btn bg-white text-primary-600 hover:bg-slate-100 text-base !px-7 !py-3.5">
