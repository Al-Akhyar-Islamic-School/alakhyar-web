---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BeritaCard from '../../components/BeritaCard.astro';
import { jenjang, site } from '../../data/site';

export function getStaticPaths() {
  return jenjang.map((j) => ({ params: { slug: j.slug }, props: { j } }));
}

const { j } = Astro.props;

// Berita terkait jenjang ini (dari tag hasil migrasi WordPress)
const terkait = (
  await getCollection('berita', ({ data }) => !data.draft && data.tags.includes(j.tagWp))
)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const warnaHero: Record<string, string> = {
  primary: 'from-primary-500 to-primary-700',
  sky: 'from-sky-500 to-sky-600',
  magenta: 'from-magenta-500 to-magenta-600',
  coral: 'from-coral-500 to-coral-600',
};

const program = [
  {
    t: 'Tahfidz Qur’an & Hadits',
    d: 'Kurikulum tahfidz terstruktur dengan metode, target, dan asesmen per jenjang.',
  },
  {
    t: 'Kurikulum Merdeka Islami',
    d: 'Perencanaan mendalam CP → ATP → Modul Ajar dengan kekhasan keislaman.',
  },
  {
    t: 'Pembiasaan 7KAIH',
    d: 'Program kokurikuler pembiasaan karakter dan adab islami harian.',
  },
  {
    t: 'Sistem Poinku',
    d: 'Poin Akhlak & Poin Unggul — apresiasi karakter hingga mekanisme beasiswa.',
  },
  {
    t: 'Dinar App',
    d: 'Orang tua memantau perkembangan ananda langsung dari aplikasi sekolah.',
  },
  {
    t: 'Ekstrakurikuler',
    d: 'Pengembangan minat-bakat: pramuka, olahraga, seni, sains, dan dai cilik.',
  },
];
---

<BaseLayout title={j.lengkap} description={j.deskripsi}>
  <!-- hero berwarna khas jenjang (gaya feature-header Dinar) -->
  <section class={`relative bg-gradient-to-br ${warnaHero[j.warna]} text-white overflow-hidden rounded-b-[32px]`}>
    <div class="absolute inset-0 pattern-dots" aria-hidden="true"></div>
    <div class="container-ak relative py-16 md:py-20 max-w-3xl">
      <a href="/jenjang" class="text-sm text-white/70 hover:text-white">← Semua jenjang</a>
      <p class="text-white/70 uppercase tracking-widest text-xs font-bold mt-6">{j.umur}</p>
      <h1 class="font-display text-4xl md:text-5xl font-bold mt-2 mb-4">{j.lengkap}</h1>
      <p class="text-lg text-white/85 leading-relaxed max-w-2xl">{j.deskripsi}</p>
    </div>
  </section>

  <section class="container-ak py-16">
    <div class="max-w-2xl mb-10" data-reveal>
      <span class="eyebrow">Program</span>
      <h2 class="text-3xl font-bold text-ink mt-2">Yang Ananda Dapatkan</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        program.map((p, i) => (
          <div class="card-ak p-6" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <h3 class="font-bold text-ink mb-1.5">{p.t}</h3>
            <p class="text-sm text-slate-500">{p.d}</p>
          </div>
        ))
      }
    </div>
    <p class="text-sm text-slate-400 mt-6">
      Detail struktur belajar &amp; beban jam per jenjang:
      <a href={site.kurikulumUrl} target="_blank" rel="noopener" class="text-primary-600 font-semibold hover:underline">
        kurikulum.alakhyar.sch.id
      </a>
    </p>
  </section>

  {
    terkait.length > 0 && (
      <section class="bg-slate-100/70 border-y border-slate-200">
        <div class="container-ak py-16">
          <div class="flex items-end justify-between mb-8" data-reveal>
            <div>
              <span class="eyebrow">Kabar {j.nama}</span>
              <h2 class="text-2xl md:text-3xl font-bold text-ink mt-2">Kegiatan Terbaru</h2>
            </div>
            <a href="/berita" class="text-sm font-semibold text-primary-600 hover:text-primary-700">
              Semua berita →
            </a>
          </div>
          <div class="grid md:grid-cols-3 gap-6">
            {terkait.map((post) => (
              <BeritaCard post={post} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="container-ak py-16">
    <div class="rounded-[24px] bg-brand-gradient text-white p-10 md:p-12 text-center shadow-brand relative overflow-hidden" data-reveal>
      <div class="absolute inset-0 pattern-dots" aria-hidden="true"></div>
      <div class="relative">
        <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">
          Daftarkan Ananda di {j.lengkap}
        </h2>
        <p class="text-white/80 mb-7 max-w-lg mx-auto">
          Kuota terbatas. Tersedia jalur beasiswa tahfidz untuk calon siswa berprestasi.
        </p>
        <a href="/spmb" class="btn bg-white text-primary-600 hover:bg-slate-100">Info SPMB 2026/2027</a>
      </div>
    </div>
  </section>
</BaseLayout>
