---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BeritaCard from '../../components/BeritaCard.astro';
import Placeholder from '../../components/Placeholder.astro';
import AlumniSMA from '../../components/AlumniSMA.astro';
import { jenjang, site, programUnggulan } from '../../data/site';

export function getStaticPaths() {
  return jenjang.map((j) => ({ params: { slug: j.slug }, props: { j } }));
}

const { j } = Astro.props;

// Berita terkait jenjang ini (dari tag hasil migrasi WordPress)
const terkait = (
  await getCollection('berita', ({ data }) => !data.draft && data.tags.includes(j.tagWp))
)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const warnaHero: Record<string, string> = {
  primary: 'from-primary-500 to-primary-700',
  sky: 'from-sky-500 to-sky-600',
  magenta: 'from-magenta-500 to-magenta-600',
  coral: 'from-coral-500 to-coral-600',
};
---

<BaseLayout title={j.lengkap} description={j.deskripsi}>
  <!-- hero berwarna khas jenjang (gaya feature-header Dinar) -->
  <section class={`relative bg-gradient-to-br ${warnaHero[j.warna]} text-white overflow-hidden rounded-b-[32px]`}>
    <div class="absolute inset-0 pattern-dots" aria-hidden="true"></div>
    <div class="container-ak relative py-16 md:py-20">
      <div class="grid lg:grid-cols-[1.2fr_1fr] gap-10 items-center">
        <div>
          <a href="/jenjang" class="text-sm text-white/70 hover:text-white">← Semua jenjang</a>
          <div class="flex items-center gap-3 mt-6">
            <p class="text-white/70 uppercase tracking-widest text-xs font-bold">{j.umur}</p>
            <span class="chip bg-white/15 text-white">Sejak {j.berdiri}</span>
          </div>
          <h1 class="font-display text-4xl md:text-5xl font-bold mt-2 mb-4">{j.lengkap}</h1>
          <p class="text-lg text-white/85 leading-relaxed max-w-2xl mb-7">{j.deskripsi}</p>
          <div class="flex flex-wrap gap-3">
            <a href={j.booklet} target="_blank" rel="noopener" class="btn bg-white text-primary-700 hover:bg-slate-100 !py-2.5 text-sm">
              📖 Unduh Booklet {j.nama}
            </a>
            <a href="/spmb" class="btn border border-white/40 text-white hover:bg-white/10 !py-2.5 text-sm">
              Info SPMB
            </a>
          </div>
        </div>
        <Placeholder
          label={`Foto kegiatan siswa ${j.nama} (landscape, suasana khas jenjang)`}
          class="!border-white/40 !bg-white/10 [&_p]:!text-white/70 [&_svg]:!text-white/50 hidden lg:flex"
        />
      </div>
    </div>
  </section>

  <!-- Kekhasan jenjang (konten booklet & situs lama) -->
  <section class="container-ak pt-14">
    <div class="grid sm:grid-cols-2 gap-5">
      {
        j.keunikan.map((k, i) => (
          <div
            class="rounded-2xl bg-primary-50/60 border border-primary-100 p-6 flex gap-3 items-start"
            data-reveal
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <span class="shrink-0 w-6 h-6 rounded-full bg-primary-500 text-white text-xs font-bold flex items-center justify-center mt-0.5">
              ✓
            </span>
            <p class="text-sm text-slate-600 leading-relaxed">{k}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Program khas (TK) / Ekstrakurikuler -->
  {
    j.programKhas.length > 0 && (
      <section class="container-ak pt-12">
        <div class="mb-6" data-reveal>
          <span class="eyebrow">Program Harian &amp; Khas</span>
        </div>
        <div class="flex flex-wrap gap-2.5">
          {j.programKhas.map((p) => (
            <span class="chip !text-[13px] !normal-case !tracking-normal !font-semibold bg-white border border-slate-200 text-slate-600 !px-4 !py-2">
              {p}
            </span>
          ))}
        </div>
      </section>
    )
  }
  {
    j.ekskul.length > 0 && (
      <section class="container-ak pt-12">
        <div class="mb-6" data-reveal>
          <span class="eyebrow">Ekstrakurikuler &amp; Organisasi</span>
        </div>
        <div class="flex flex-wrap gap-2.5">
          {j.ekskul.map((e) => (
            <span class="chip !text-[13px] !normal-case !tracking-normal !font-semibold bg-white border border-slate-200 text-slate-600 !px-4 !py-2">
              {e}
            </span>
          ))}
        </div>
      </section>
    )
  }

  <!-- Program unggulan lintas jenjang -->
  <section class="container-ak py-16">
    <div class="max-w-2xl mb-10" data-reveal>
      <span class="eyebrow">Program Unggulan</span>
      <h2 class="text-3xl font-bold text-ink mt-2">Yang Ananda Dapatkan</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        programUnggulan.map((p, i) => (
          <div class="card-ak p-6" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <h3 class="font-bold text-ink mb-1.5">{p.t}</h3>
            <p class="text-sm text-slate-500">{p.d}</p>
          </div>
        ))
      }
    </div>
    <p class="text-sm text-slate-400 mt-6">
      Struktur belajar &amp; beban jam lengkap:
      <a href={site.kurikulumUrl} target="_blank" rel="noopener" class="text-primary-600 font-semibold hover:underline">
        kurikulum.alakhyar.sch.id
      </a>
      · Pantau harian ananda lewat
      <a href={site.dinarUrl} target="_blank" rel="noopener" class="text-primary-600 font-semibold hover:underline">Dinar App</a>
    </p>
  </section>

  {
    j.slug === 'sma' && (
      <section class="container-ak pb-16">
        <AlumniSMA />
      </section>
    )
  }

  {
    terkait.length > 0 && (
      <section class="bg-slate-100/70 border-y border-slate-200">
        <div class="container-ak py-16">
          <div class="flex items-end justify-between mb-8" data-reveal>
            <div>
              <span class="eyebrow">Kabar {j.nama}</span>
              <h2 class="text-2xl md:text-3xl font-bold text-ink mt-2">Kegiatan Terbaru</h2>
            </div>
            <a href="/berita" class="text-sm font-semibold text-primary-600 hover:text-primary-700">
              Semua berita →
            </a>
          </div>
          <div class="grid md:grid-cols-3 gap-6">
            {terkait.map((post) => (
              <BeritaCard post={post} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="container-ak py-16">
    <div class="rounded-[24px] bg-brand-gradient text-white p-10 md:p-12 text-center shadow-brand relative overflow-hidden" data-reveal>
      <div class="absolute inset-0 pattern-dots" aria-hidden="true"></div>
      <div class="relative">
        <h2 class="font-display text-2xl md:text-3xl font-bold mb-3">
          Daftarkan Ananda di {j.lengkap}
        </h2>
        <p class="text-white/80 mb-7 max-w-lg mx-auto">
          Kuota terbatas. Tersedia jalur beasiswa tahfidz untuk calon siswa berprestasi.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href={site.spmbUrl} target="_blank" rel="noopener" class="btn bg-white text-primary-600 hover:bg-slate-100">
            Daftar di spmb.alakhyar.sch.id
          </a>
          <a href={j.booklet} target="_blank" rel="noopener" class="btn border border-white/40 text-white hover:bg-white/10">
            Unduh Booklet
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
