---
// Halaman Guru & Tenaga Kependidikan.
// Data di-embed langsung dari SIMGTK (aplikasi kepegawaian sekolah) agar selalu
// terbarui tanpa perlu update manual di situs ini.
//
// Endpoint /public/gtk/embed mengirim header:
//   Content-Security-Policy: frame-ancestors 'self' https://alakhyar.sch.id https://*.alakhyar.sch.id
// sehingga hanya bisa ditampilkan dari domain Al Akhyar.
// CATATAN: karena itu iframe TIDAK akan tampil saat dites di localhost — ini
// normal, bukan bug. Verifikasi tampilannya langsung di alakhyar.sch.id/guru.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

const SIMGTK_EMBED = 'https://simgtk.alakhyar.sch.id/public/gtk/embed';
const SIMGTK_PENUH = 'https://simgtk.alakhyar.sch.id/public/gtk/data';
---

<BaseLayout
  title="Guru & Tenaga Kependidikan"
  description="Data guru dan tenaga kependidikan Sekolah Islam Al Akhyar Makassar — TK/KB, SD, SMP, dan SMA Islam."
>
  <PageHeader
    eyebrow="Guru & Tenaga Kependidikan"
    title="Pendidik di Balik Setiap Prestasi"
    subtitle="Kami siap mendampingi putra-putri Anda tumbuh menjadi generasi berprestasi dan berkarakter islami."
  />

  <section class="container-ak py-10">
    <div
      class="rounded-2xl border border-slate-200 bg-white shadow-sm overflow-hidden"
      data-reveal
    >
      <iframe
        src={SIMGTK_EMBED}
        title="Data Guru & Tenaga Kependidikan Al Akhyar"
        class="w-full border-0 block h-[1200px]"
        loading="lazy"
      ></iframe>
    </div>

    <p class="text-sm text-slate-400 mt-5 text-center">
      Data ditarik langsung dari SIMGTK dan selalu terbarui.
      <a href={SIMGTK_PENUH} target="_blank" rel="noopener" class="text-primary-600 font-semibold hover:underline">
        Buka versi lengkap ↗
      </a>
    </p>

    <p class="text-sm text-slate-400 mt-2 text-center">
      Ingin bergabung sebagai pendidik?
      <a href="https://s.alakhyar.sch.id/karir" target="_blank" rel="noopener" class="text-primary-600 font-semibold hover:underline">
        Lihat peluang karir
      </a>
    </p>
  </section>
</BaseLayout>
