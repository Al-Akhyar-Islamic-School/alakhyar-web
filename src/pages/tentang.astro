---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site, pilar, stats, visi, misi, sejarah, akreditasi } from '../data/site';
import gedungUtama from '../assets/foto/gedung-utama.jpg';
import gedungSD from '../assets/foto/gedung-sd.jpg';
import gedungTK from '../assets/foto/gedung-tk.jpg';
import gedungSMA from '../assets/foto/gedung-sma.jpg';

const warnaPilar: Record<string, string> = {
  primary: 'border-t-primary-500',
  sky: 'border-t-sky-500',
  green: 'border-t-green-500',
};
---

<BaseLayout
  title="Tentang Kami"
  description="Sejarah, visi-misi, dan pilar pendidikan Sekolah Islam Al Akhyar Makassar — berkiprah sejak 2004."
>
  <PageHeader
    eyebrow="Tentang Kami"
    title="Sekolah Islam Al Akhyar"
    subtitle="Unggul di bidang prestasi, berakhlak mulia dalam perilaku — sejak 2004."
  />

  <!-- Sejarah singkat + foto -->
  <section class="container-ak py-16 grid lg:grid-cols-2 gap-12 items-center">
    <div data-reveal>
      <span class="eyebrow">Sejarah Singkat</span>
      <h2 class="text-3xl font-bold text-ink mt-2 mb-5">Bermula dari Sebuah Nama yang Bermakna</h2>
      <div class="space-y-4 text-slate-600 leading-relaxed">
        <p>
          Al Akhyar Islamic School lahir dari komitmen <strong>H. Dzulkifli Dinar, Lc.</strong>
          dan <strong>Hj. Musdalifah Sappe</strong> untuk memajukan pendidikan generasi bangsa.
          Nama <em>Al Akhyar</em> — dari kata bahasa Arab <em>khair</em> — berarti
          <strong>“yang terbaik”</strong>: spirit seluruh civitas akademika untuk unggul di
          bidang prestasi dan berakhlak mulia dalam perilaku.
        </p>
        <p>
          Kini Al Akhyar menaungi empat jenjang — TK/KB, SD, SMP, dan SMA Islam — dengan lebih
          dari 900 peserta didik dan kurikulum yang terdokumentasi terbuka.
        </p>
      </div>
    </div>
    <div class="relative" data-reveal style="--reveal-delay: 120ms">
      <Image
        src={gedungUtama}
        alt="Kampus Sekolah Islam Al Akhyar, Sudiang Makassar"
        class="w-full aspect-[4/3] object-cover rounded-[28px] shadow-lg -rotate-1"
        widths={[480, 960]}
        sizes="(max-width: 1024px) 92vw, 520px"
      />
      <div class="absolute -bottom-6 left-8 bg-white rounded-2xl shadow-md border border-slate-200 px-6 py-4 rotate-1">
        <p class="font-display font-bold text-2xl text-primary-600 leading-none">4.200 m²</p>
        <p class="text-xs text-slate-500 mt-1">Kampus di Sudiang, Makassar</p>
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="container-ak pb-16">
    <div class="mb-8" data-reveal>
      <span class="eyebrow">Perjalanan Kami</span>
      <h2 class="text-3xl font-bold text-ink mt-2">Tonggak Sejarah</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {
        sejarah.map((s, i) => (
          <div class="card-ak p-6 relative" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <p class="font-display font-bold text-3xl text-gradient-brand mb-2">{s.tahun}</p>
            <h3 class="font-bold text-ink mb-1.5">{s.judul}</h3>
            <p class="text-sm text-slate-500">{s.teks}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Stats -->
  <section class="bg-brand-gradient relative overflow-hidden">
    <div class="absolute inset-0 pattern-dots" aria-hidden="true"></div>
    <div class="container-ak relative grid grid-cols-2 lg:grid-cols-4 gap-y-8 py-12">
      {
        stats.map((s, i) => (
          <div class="text-center text-white" data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <p class="font-display font-bold text-4xl mb-1">{s.angka}</p>
            <p class="font-semibold text-white/95 text-sm">{s.label}</p>
            <p class="text-xs text-white/60 mt-0.5">{s.ket}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Visi & Misi -->
  <section class="container-ak py-16">
    <div class="grid lg:grid-cols-[1fr_1.3fr] gap-10">
      <div data-reveal>
        <span class="eyebrow">Visi</span>
        <blockquote class="mt-4 rounded-[24px] bg-primary-50 border border-primary-100 p-8">
          <p class="font-display text-2xl font-bold text-primary-700 leading-snug">
            “{visi}”
          </p>
        </blockquote>
      </div>
      <div data-reveal style="--reveal-delay: 100ms">
        <span class="eyebrow">Misi</span>
        <ol class="mt-4 space-y-3">
          {
            misi.map((m, i) => (
              <li class="flex gap-3.5 items-start">
                <span class="shrink-0 w-7 h-7 rounded-full bg-primary-500 text-white text-xs font-bold flex items-center justify-center mt-0.5">
                  {i + 1}
                </span>
                <p class="text-slate-600">{m}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- Pilar -->
  <section class="container-ak pb-16">
    <div class="max-w-2xl mb-10" data-reveal>
      <span class="eyebrow">Arah Pendidikan</span>
      <h2 class="text-3xl font-bold text-ink mt-2">Tiga Pilar Kurikulum</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {
        pilar.map((p, i) => (
          <div class={`card-ak border-t-4 ${warnaPilar[p.warna]} p-8`} data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <h3 class="font-bold text-ink text-xl mb-2">{p.nama}</h3>
            <p class="text-slate-500">{p.deskripsi}</p>
          </div>
        ))
      }
    </div>
    <p class="text-sm text-slate-400 mt-6">
      Dokumen kurikulum lengkap tersedia di
      <a href={site.kurikulumUrl} target="_blank" rel="noopener" class="text-primary-600 font-semibold hover:underline">kurikulum.alakhyar.sch.id</a>.
    </p>
  </section>

  <!-- Kampus kami -->
  <section class="container-ak pb-16">
    <div class="max-w-2xl mb-8" data-reveal>
      <span class="eyebrow">Kampus Kami</span>
      <h2 class="text-3xl font-bold text-ink mt-2">Tiga Gedung, Satu Lingkungan Islami</h2>
    </div>
    <div class="grid sm:grid-cols-3 gap-5">
      {
        [
          { src: gedungTK, ket: 'Gedung KB-TK Islam' },
          { src: gedungSD, ket: 'Gedung SD & SMP Islam' },
          { src: gedungSMA, ket: 'Gedung SMA Islam' },
        ].map((g, i) => (
          <figure data-reveal style={`--reveal-delay: ${i * 90}ms`}>
            <Image
              src={g.src}
              alt={g.ket}
              class="w-full aspect-[4/3] object-cover rounded-2xl shadow-sm"
              widths={[360, 720]}
              sizes="(max-width: 640px) 90vw, 360px"
              loading="lazy"
            />
            <figcaption class="text-sm text-slate-500 mt-2.5 text-center">{g.ket}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <!-- Akreditasi -->
  <section class="container-ak pb-16">
    <div class="mb-8" data-reveal>
      <span class="eyebrow">Mutu</span>
      <h2 class="text-3xl font-bold text-ink mt-2">Akreditasi BAN-S/M</h2>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-5">
      {
        akreditasi.map((a, i) => (
          <div class="card-ak p-6 text-center" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <p class="font-display font-bold text-4xl text-primary-600 mb-1">{a.nilai}</p>
            <p class="text-sm font-semibold text-ink">{a.jenjang}</p>
          </div>
        ))
      }
    </div>
  </section>

</BaseLayout>
