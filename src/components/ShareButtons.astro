---
// Tombol bagikan artikel ke media sosial.
// Tanpa library eksternal — hanya URL share resmi tiap platform + SVG inline,
// agar halaman tetap ringan (tidak ada JS pihak ketiga yang melacak pembaca).
//
// Catatan: Instagram TIDAK menyediakan URL share dari web. Untuk itu tersedia
// tombol "Bagikan" (Web Share API) yang di HP membuka menu berbagi bawaan —
// di sanalah Instagram, TikTok, dsb. muncul.
interface Props {
  url: string;
  title: string;
  variant?: 'ringkas' | 'penuh';
}
const { url, title, variant = 'ringkas' } = Astro.props;

const u = encodeURIComponent(url);
const t = encodeURIComponent(title);

const tautan = [
  {
    nama: 'WhatsApp',
    href: `https://wa.me/?text=${t}%20${u}`,
    warna: 'hover:bg-[#25D366] hover:border-[#25D366]',
    path: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z',
  },
  {
    nama: 'Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${u}`,
    warna: 'hover:bg-[#1877F2] hover:border-[#1877F2]',
    path: 'M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 011.141.195v3.325a8.623 8.623 0 00-.653-.036 26.805 26.805 0 00-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 00-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z',
  },
  {
    nama: 'Telegram',
    href: `https://t.me/share/url?url=${u}&text=${t}`,
    warna: 'hover:bg-[#26A5E4] hover:border-[#26A5E4]',
    path: 'M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z',
  },
  {
    nama: 'X',
    href: `https://x.com/intent/tweet?url=${u}&text=${t}`,
    warna: 'hover:bg-black hover:border-black',
    path: 'M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z',
  },
];

const kelasIkon =
  'w-9 h-9 rounded-full border border-slate-200 bg-white text-slate-500 flex items-center justify-center transition-all duration-200 hover:text-white hover:-translate-y-0.5 hover:shadow-md';
---

<div
  class:list={[
    'ak-share',
    variant === 'penuh'
      ? 'rounded-2xl border border-slate-200 bg-slate-50 p-6 text-center'
      : 'flex items-center gap-2.5 flex-wrap',
  ]}
  data-url={url}
  data-title={title}
>
  {
    variant === 'penuh' && (
      <p class="font-bold text-ink mb-1">Bagikan artikel ini</p>
      <p class="text-sm text-slate-500 mb-5">
        Bantu sebarkan kabar baik dari Al Akhyar.
      </p>
    )
  }

  <div class:list={['flex items-center gap-2.5 flex-wrap', variant === 'penuh' && 'justify-center']}>
    {variant === 'ringkas' && <span class="text-xs font-semibold text-slate-400 mr-0.5">Bagikan</span>}

    {
      tautan.map((s) => (
        <a
          href={s.href}
          target="_blank"
          rel="noopener noreferrer"
          title={`Bagikan ke ${s.nama}`}
          aria-label={`Bagikan ke ${s.nama}`}
          class:list={[kelasIkon, s.warna]}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={s.path} />
          </svg>
        </a>
      ))
    }

    {/* Salin tautan — juga jalan keluar untuk Instagram (tempel di bio/story) */}
    <button
      type="button"
      class:list={[kelasIkon, 'ak-copy hover:bg-primary-500 hover:border-primary-500']}
      title="Salin tautan"
      aria-label="Salin tautan"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
      </svg>
    </button>

    {/* Menu berbagi bawaan HP — di sinilah Instagram & TikTok muncul */}
    <button
      type="button"
      class:list={[kelasIkon, 'ak-native hidden hover:bg-magenta-500 hover:border-magenta-500']}
      title="Bagikan ke aplikasi lain"
      aria-label="Bagikan ke aplikasi lain"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" />
        <path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4" />
      </svg>
    </button>
  </div>

  <span class="ak-toast hidden text-xs font-semibold text-green-600 mt-3">Tautan tersalin ✓</span>
</div>

<script>
  // Satu skrip untuk semua instance (atas & bawah artikel).
  document.querySelectorAll('.ak-share').forEach((box) => {
    const el = box as HTMLElement;
    const url = el.dataset.url || location.href;
    const title = el.dataset.title || document.title;
    const toast = el.querySelector('.ak-toast');

    const beriTahu = () => {
      if (!toast) return;
      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 2000);
    };

    el.querySelector('.ak-copy')?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        beriTahu();
      } catch {
        // fallback bila clipboard API diblokir (mis. konteks non-HTTPS)
        const ta = document.createElement('textarea');
        ta.value = url;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
        beriTahu();
      }
    });

    // Tampilkan tombol "bagikan ke aplikasi" hanya bila perangkat mendukung
    const native = el.querySelector('.ak-native');
    if (native && typeof navigator.share === 'function') {
      native.classList.remove('hidden');
      native.addEventListener('click', () => {
        navigator.share({ title, url }).catch(() => {});
      });
    }
  });
</script>
