---
// Placeholder gambar — tandai titik yang perlu foto asli. Ganti dengan <img>/<Image>
// saat foto tersedia. Label menjelaskan foto apa yang dibutuhkan.
interface Props {
  label: string;
  class?: string;
  ratio?: string; // mis. "aspect-[4/3]"
}
const { label, class: cls = '', ratio = 'aspect-[4/3]' } = Astro.props;
---

<div
  class:list={[
    ratio,
    cls,
    'relative rounded-2xl border-2 border-dashed border-primary-200 bg-primary-50/50 flex flex-col items-center justify-center gap-2 text-center p-6 overflow-hidden',
  ]}
>
  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-primary-300">
    <rect x="3" y="3" width="18" height="18" rx="3" />
    <circle cx="9" cy="9" r="2" />
    <path d="m21 15-3.5-3.5a2 2 0 0 0-2.8 0L6 20" />
  </svg>
  <p class="text-xs font-semibold text-primary-400 max-w-[220px]">{label}</p>
</div>
