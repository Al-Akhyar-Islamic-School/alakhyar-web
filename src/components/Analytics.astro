---
// Pelacakan pengunjung: Google Analytics 4 + Microsoft Clarity.
//
// ID diambil dari environment variable, bukan ditulis di kode:
//   PUBLIC_GA_ID       -> G-XXXXXXXXXX   (Google Analytics 4)
//   PUBLIC_CLARITY_ID  -> xxxxxxxxxx     (Microsoft Clarity)
// Atur di Netlify: Site configuration > Environment variables.
//
// Bila variabelnya kosong, tidak ada skrip yang dimuat sama sekali — sehingga
// `npm run dev` di komputer tidak ikut tercatat sebagai kunjungan.
// Halaman /admin juga tidak terlacak karena tidak memakai BaseLayout.
const GA = import.meta.env.PUBLIC_GA_ID;
const CLARITY = import.meta.env.PUBLIC_CLARITY_ID;
---

{
  GA && (
    <Fragment>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA}`} />
      <script is:inline define:vars={{ GA }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        // anonymize_ip: jangan simpan alamat IP utuh pengunjung
        gtag('config', GA, { anonymize_ip: true });
      </script>
    </Fragment>
  )
}

{
  CLARITY && (
    <script is:inline define:vars={{ CLARITY }}>
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = 'https://www.clarity.ms/tag/' + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', CLARITY);
    </script>
  )
}
