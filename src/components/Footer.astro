---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-mark-white.png';
import { site, nav, jenjang } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="bg-primary-700 text-white/80 mt-20">
  <div class="container-ak py-14 grid gap-10 md:grid-cols-4">
    <div class="md:col-span-1">
      <Image src={logo} alt={site.name} width={112} height={112} class="h-12 w-12 mb-4" />
      <p class="text-sm leading-relaxed text-white/70 max-w-xs">
        {site.description}
      </p>
    </div>

    <div>
      <h3 class="text-white font-semibold text-sm mb-3">Jenjang</h3>
      <ul class="space-y-2 text-sm">
        {jenjang.map((j) => (
          <li><a href={`/jenjang/${j.slug}`} class="hover:text-white transition-colors">{j.nama}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-white font-semibold text-sm mb-3">Tautan</h3>
      <ul class="space-y-2 text-sm">
        {nav.filter((n) => n.href !== '/').map((item) => (
          <li><a href={item.href} class="hover:text-white transition-colors">{item.label}</a></li>
        ))}
        <li><a href="/spmb" class="hover:text-white transition-colors">SPMB / PPDB</a></li>
        <li><a href={site.kurikulumUrl} target="_blank" rel="noopener" class="hover:text-white transition-colors">Kurikulum ↗</a></li>
        <li><a href={site.dinarUrl} target="_blank" rel="noopener" class="hover:text-white transition-colors">Dinar App ↗</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-white font-semibold text-sm mb-3">Kontak</h3>
      <ul class="space-y-2 text-sm text-white/70">
        <li>{site.address}</li>
        <li><a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a></li>
        <li>{site.phone}</li>
        <li><a href={site.instagram} target="_blank" rel="noopener" class="hover:text-white">Instagram {site.instagramHandle}</a></li>
        <li class="text-white/50 pt-1">{site.officeHours}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-ak py-5 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-white/50">
      <p>© {year} {site.name}. Semua hak cipta dilindungi.</p>
      <div class="flex items-center gap-4">
        <a href="/stop-bullying" class="hover:text-white">Stop Bullying</a>
        <a href="/privacy-policy" class="hover:text-white">Kebijakan Privasi</a>
        <a href="/syarat-dan-ketentuan" class="hover:text-white">Syarat &amp; Ketentuan</a>
      </div>
    </div>
  </div>
</footer>
